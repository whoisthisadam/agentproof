secrets/

# Raw data pulled during a task: summarise it in evidence, never commit it
/tasks/**/data/
/examples/**/tasks/**/data/

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Agent session artifacts that capture screen or page contents
.playwright-mcp/
.claude/settings.local.json

# Crash dumps from Windows tools
*.stackdump
hs_err_pid*.log
