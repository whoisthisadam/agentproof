# .env.example: names and purposes only. Values come from your secret manager at runtime.
# Copy to .env.lab or .env.production (both gitignored), or use `op run` / `doppler run` / `sops exec-env`.

# agentproof
AGENTPROOF_ENV=lab                 # lab | production. Production must be set explicitly by the human.
AGENTPROOF_OPERATOR=changeme       # who is running the session

# Example product secrets (referenced as $NAME in tasks and evidence, never by value)
PULSE_DB_URL=changeme              # PostgreSQL connection string for the lab database
PULSE_DB_PASSWORD=changeme
DEALERHUB_API_TOKEN=changeme       # DealerHub CRM partner token, lab tenant
VETLINK_CLIENT_SECRET=changeme     # VetLink API OAuth client secret, sandbox
GRAFANA_API_TOKEN=changeme         # read-only token for dashboards and alert state
