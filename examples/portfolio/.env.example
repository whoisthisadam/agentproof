# Names and purposes only. Values come from the password manager at runtime: `op run --env-file=.env.tpl -- <cmd>`.

AGENTPROOF_ENV=lab                    # lab | production. Production is set by Adam per session.
AGENTPROOF_OPERATOR=changeme

# Pulse
PULSE_DB_URL=changeme                 # PostgreSQL, lab instance on build-runner-01
PULSE_FCM_SERVICE_ACCOUNT=changeme    # path to the push service account file, outside the repo

# AutoDeal Bot
AUTODEAL_TELEGRAM_BOT_TOKEN=changeme
AUTODEAL_LLM_API_KEY=changeme
DEALERHUB_WEBHOOK_SECRET=changeme     # HMAC secret for DealerHub CRM webhook signatures

# pet.me
VETLINK_CLIENT_ID=changeme
VETLINK_CLIENT_SECRET=changeme        # VetLink API sandbox

# Tunnelr
TF_VAR_provider_api_token=changeme    # hosting provider API, Terraform only
GRAFANA_API_TOKEN=changeme            # read-only

# RentRadar
RENTRADAR_KAFKA_BOOTSTRAP=changeme

# Shelfie
RECEIPTLENS_API_KEY=changeme          # ReceiptLens OCR API
